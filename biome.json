{
  "$schema": "https://biomejs.dev/schemas/latest/schema.json",
  "extends": ["ultracite/biome/core"],
  "files": {
    "includes": [
      "!**/node_modules",
      "!**/.tools",
      "!**/.venv-train",
      "!**/.turbo",
      "!**/.wrangler",
      "!**/dist"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "overrides": [
    {
      "includes": ["**/index.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          },
          "style": {
            "noExportedImports": "off"
          }
        }
      }
    }
  ]
}
