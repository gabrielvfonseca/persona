# Copy to .env and fill in. Every key is read by src/config.ts. Runs in Docker (docker/compose.yaml).

# Required
PERSONA_CONSENT=true                 # must be exactly "true": you have the subject's consent
PERSONA_NAME=Ana                     # display name; also used for "addressed by name" matching
# PERSONA_MODEL=qwen2.5-0.5b         # qwen2.5-0.5b, qwen2.5-1.5b, smollm2-360m, or a .gguf path. Unset: the active fine-tuned model, else qwen2.5-0.5b

# Optional
PERSONA_FILE=data/persona.json       # a persona JSON file, written by hand
ADMIN_NUMBERS=                       # comma-separated phone numbers allowed to run !pause / !resume
MAX_PER_10MIN=5                      # replies per chat per 10 minutes
# MODEL_TEMPERATURE=0.2              # sampling temperature; 0.5 to 0.8 suits a persona, low values repeat themselves
# MODEL_CONTEXT=4096                 # context window for the local model, in tokens
# MEMORY_MAX_NODES=50000             # most memory nodes kept searchable; raise it after importing a large history
# API_PORT=8787                      # serve the ingest API on this port (unset: no API)
# API_KEY=                           # bearer token for the ingest API; 16+ characters
# PROMPT_EXCHANGES=40                 # real exchanges from the chat shown to the model as examples
RECALL_LIMIT=4                       # past messages added to each prompt; 0 turns recall off
# LEARNING_ENABLED=true              # continuous learning; must be exactly "true" when set
# LEARNING_WARMUP=5                  # outcomes before weights start moving
# LEARNING_STEP=0.5                  # step size for weight nudges
# LEARNING_DISTILL_EVERY=20          # distill every N outcomes
# LEARNING_MAX_PATCH=5               # max facts/phrases per patch

AUTH_DIR=.auth                       # WhatsApp session credentials; keep out of git

# Postgres (pgvector). Required. docker/compose.yaml sets it for the container.
DATABASE_URL=postgres://persona:persona@localhost:5432/persona   # holds history, dedupe, rate limits, pause, learning, memory
# Supabase: append ?uselibpqcompat=true&sslmode=require to the URL when your machine does not trust its certificate chain.
# MEMORY_MAX_NODES must be large enough for an imported history (see the Calhau section in README.md).

# Semantic recall. ggml-node embedding model, run in-process. Downloaded on first use.
# Must produce 384-dimension vectors.
# EMBEDDING_MODEL=bge-small-en-v1.5
